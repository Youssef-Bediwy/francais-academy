# ---------- Base de donnees ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/francais_academy?schema=public"

# ---------- Auth ----------
# openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-un-secret-de-32-caracteres-minimum"
AUTH_COOKIE_NAME="fa_session"
AUTH_SESSION_TTL_DAYS="30"

# ---------- Application ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NODE_ENV="development"

# ---------- Seed (compte admin de demonstration) ----------
SEED_ADMIN_EMAIL="admin@francais-academy.com"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_DEMO_EMAIL="demo@francais-academy.com"
SEED_DEMO_PASSWORD="Demo1234!"
